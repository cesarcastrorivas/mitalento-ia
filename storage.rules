rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Videos: solo admins pueden subir/modificar/eliminar
    // Los estudiantes solo pueden leer (reproducir) videos
    match /videos/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Avatares de perfil: el usuario sube el suyo, admins pueden gestionar cualquiera
    match /avatars/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
          request.auth.uid == userId ||
          firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Thumbnails de cursos: solo admins pueden subir/modificar/eliminar
    match /course-thumbnails/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Herramientas: archivos del repositorio central (video/audio/image/pdf/exe)
    // - Lectura: cualquier autenticado (reproducir/ver/descargar inline).
    // - Escritura: solo admins. Límite por tipo enforzado aquí Y en UI:
    //     image 5MB · pdf 10MB · audio 20MB · video 100MB · exe 500MB
    match /tools/{toolId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin'
        && (
          (request.resource.contentType.matches('image/.*')        && request.resource.size <   5 * 1024 * 1024) ||
          (request.resource.contentType == 'video/mp4'             && request.resource.size < 100 * 1024 * 1024) ||
          (request.resource.contentType == 'audio/mpeg'            && request.resource.size <  20 * 1024 * 1024) ||
          (request.resource.contentType == 'application/pdf'       && request.resource.size <  10 * 1024 * 1024) ||
          (
            (
              request.resource.contentType == 'application/x-msdownload' ||
              request.resource.contentType == 'application/vnd.microsoft.portable-executable' ||
              request.resource.contentType == 'application/octet-stream'
            )
            && request.resource.size < 500 * 1024 * 1024
          )
        );
    }
  }
}
